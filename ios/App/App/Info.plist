<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>My Fit Pod</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Found 2026-09-09, same audit that added Android's ACCESS_FINE_LOCATION:
	     the door-unlock geofence check (src/app/api/unlock/route.ts) calls
	     plain navigator.geolocation.getCurrentPosition() in the WebView —
	     without this key, iOS denies it outright with no prompt shown, same
	     failure mode as the Android gap (a silent "Turn on location
	     services" error indistinguishable from location genuinely being
	     off). "When in use" only — this app never needs location in the
	     background. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>My Fit Pod uses your location to confirm you're at the gym before unlocking the door.</string>
	<!-- Found 2026-09-09, same audit as the Android camera gap: the
	     Nutrition tab's barcode scanner (html5-qrcode) calls
	     navigator.mediaDevices.getUserMedia({video: ...}) — WKWebView
	     silently denies camera access with no usage string declared, same
	     failure mode as every other missing-permission bug tonight. -->
	<key>NSCameraUsageDescription</key>
	<string>My Fit Pod uses your camera to scan food barcodes when logging meals.</string>
	<!-- Found 2026-09-09 while scoping HealthKit: only read access is ever
	     requested (health-connect-client.ts's requestAuthorization call
	     passes read: READ_TYPES with no write key at all — this app never
	     writes to HealthKit), so only the share/read usage string is
	     needed, not NSHealthUpdateUsageDescription. Matches the same
	     "declare only what's actually used" principle applied to Android's
	     over-declared Health Connect permissions in the same session. -->
	<key>NSHealthShareUsageDescription</key>
	<string>My Fit Pod reads your steps, sleep, and heart rate data to calculate a daily readiness score and adjust your training recommendations.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
