<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>My Fit Pod</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- This app only uses standard HTTPS/TLS (Supabase, Kisi, Stripe API
	     calls) — no custom or proprietary encryption — so it qualifies for
	     the standard exemption. Declaring this here means Codemagic's
	     automated TestFlight submission doesn't stall on Apple's export
	     compliance question on every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Found 2026-09-09, same audit that added Android's ACCESS_FINE_LOCATION:
	     the door-unlock geofence check (src/app/api/unlock/route.ts) calls
	     plain navigator.geolocation.getCurrentPosition() in the WebView —
	     without this key, iOS denies it outright with no prompt shown, same
	     failure mode as the Android gap (a silent "Turn on location
	     services" error indistinguishable from location genuinely being
	     off). "When in use" only — this app never needs location in the
	     background. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>My Fit Pod uses your location to confirm you're at the gym before unlocking the door.</string>
	<!-- Found 2026-09-09, same audit as the Android camera gap: the
	     Nutrition tab's barcode scanner (html5-qrcode) calls
	     navigator.mediaDevices.getUserMedia({video: ...}) — WKWebView
	     silently denies camera access with no usage string declared, same
	     failure mode as every other missing-permission bug tonight. -->
	<key>NSCameraUsageDescription</key>
	<string>My Fit Pod uses your camera to scan food barcodes when logging meals.</string>
	<!-- Found 2026-09-09 while scoping HealthKit, corrected 2026-09-13 after
	     a real TestFlight upload was rejected: this app's own code only ever
	     requests read access (health-connect-client.ts's requestAuthorization
	     call passes read: READ_TYPES, no write key), but Apple's App Store
	     Connect binary scan (error 90683) flags NSHealthUpdateUsageDescription
	     as required anyway, because @capgo/capacitor-health's compiled Swift
	     plugin code references HealthKit's write-authorization API internally
	     regardless of whether this app's JS ever calls it. The "declare only
	     what's used" principle (still correct for Android's Health Connect
	     permissions, trimmed the same session) doesn't hold here — Apple's
	     scanner checks the binary's API references, not actual runtime
	     behaviour. -->
	<key>NSHealthShareUsageDescription</key>
	<string>My Fit Pod reads your steps, sleep, and heart rate data to calculate a daily readiness score and adjust your training recommendations.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>My Fit Pod does not write or modify any data in the Health app.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
