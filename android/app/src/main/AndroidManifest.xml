<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Found 2026-09-07 pre-Play-submission check: the door-unlock flow
         (src/app/api/unlock/route.ts's geofence check) calls plain
         navigator.geolocation.getCurrentPosition() in the WebView, but no
         location permission was declared here at all. Android's WebView
         geolocation bridge (Capacitor's BridgeActivity wires this up
         automatically) always denies a getCurrentPosition() call with no
         matching manifest permission — every unlock attempt in the native
         app would have silently hit the "Turn on location services to
         unlock the door" error, indistinguishable from a member with
         location actually off. FINE for GPS accuracy (needed to compare
         against a resource's unlock_radius_meters, often tens of metres);
         COARSE kept alongside it since some OEM WebViews only grant what's
         explicitly asked for. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
